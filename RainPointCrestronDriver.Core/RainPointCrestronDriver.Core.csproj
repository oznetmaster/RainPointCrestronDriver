<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFrameworks>net472;net10.0</TargetFrameworks></PropertyGroup>
  <ItemGroup Condition="'$(RainPointClientProject)' == ''"><PackageReference Include="RainPointClient" Version="1.2.1" /></ItemGroup>
  <ItemGroup Condition="'$(RainPointClientProject)' != ''"><ProjectReference Include="$(RainPointClientProject)" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="RainPointCrestronDriver.Tests" /></ItemGroup>

  <!-- XML documentation is part of the supported source/API contract in both configurations. -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1570;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1711;CS1712</WarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Debug'">true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors Condition="'$(Configuration)' == 'Debug'">true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>
  <Import Project="../tools/Documentation.targets" />
</Project>